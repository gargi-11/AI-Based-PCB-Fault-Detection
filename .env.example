# ==============================================================================
# AI-Based PCB Fault Detection - Environment Configuration Template
# ==============================================================================
# Duplicate this file to '.env' and populate with your actual credentials.
# DO NOT commit '.env' or any credential JSON files to version control.

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Firebase Project Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here

# Firebase Admin SDK Credentials (Optional: Path to serviceAccountKey.json)
# If left empty, Firebase Admin will attempt Application Default Credentials (ADC).
FIREBASE_SERVICE_ACCOUNT_PATH=

# Local Mode / Offline Fallback (Set to true to use local storage & mock database if Firebase is unconfigured)
FIREBASE_MOCK_FALLBACK=true
